{
  "display_information": {
    "name": "Emoji Picker",
    "description": "Browse custom workspace emojis from Raycast",
    "background_color": "#191724"
  },
  "features": {
    "bot_user": {
      "display_name": "Emoji Picker",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": { "bot": ["emoji:read"] }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
